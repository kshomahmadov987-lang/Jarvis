        "import pygame\n",
        "import math\n",
        "import random\n",
        "import os\n",
        "import smtplib\n",
        "import threading\n",
        "import psutil\n",
        "import requests\n",
        "import sys\n",
        "from email.message import EmailMessage\n",
        "from docx import Document\n",
        "from openpyxl import Workbook\n",
        "from gtts import gTTS\n",
        "\n",
        "# --- КЛАСС УПРАВЛЕНИЯ JARVIS CORE ---\n",
        "class JarvisCore:\n",
        "    def __init__(self):\n",
        "        self.is_speaking = False\n",
        "        # Настройки (заполните на локальном ПК)\n",
        "        self.smtp_server = \"smtp.gmail.com\"\n",
        "        self.smtp_port = 465\n",
        "        self.email_address = \"your_email@gmail.com\"\n",
        "        self.email_password = \"your_app_password\"\n",
        "        self.weather_api_key = \"392f6a656358d537d0a53e9668517a63\"\n",
        "\n",
        "        # АВТОЗАПУСК ПРИ ИНИЦИАЛИЗАЦИИ\n",
        "        self._self_diagnosis()\n",
        "        self.monitor_resources() # Добавлена автоматическая озвучка ресурсов при старте\n",
        "\n",
        "    def _self_diagnosis(self):\n",
        "        print(\"--- Инициализация систем самодиагностики ---\")\n",
        "        dependencies = ['pygame', 'docx', 'openpyxl', 'gtts', 'psutil', 'requests']\n",
        "        missing = []\n",
        "        for lib in dependencies:\n",
        "            try:\n",
        "                __import__(lib if lib != 'docx' else 'docx')\n",
        "            except ImportError:\n",
        "                missing.append(lib)\n",
        "\n",
        "        if not os.path.exists('jarvis_face.png'):\n",
        "            print(\"[ WARNING ] Файл jarvis_face.png не найден.\")\n",
        "\n",
        "        if not missing:\n",
        "            print(\"[ OK ] Все системы в норме.\")\n",
        "            self.speak(\"Сэр, самодиагностика завершена. Все системы функционируют в штатном режиме.\")\n",
        "        else:\n",
        "            print(f\"[ ERROR ] Отсутствуют: {missing}\")\n",
        "\n",
        "    def speak(self, text):\n",
        "        def _play():\n",
        "            self.is_speaking = True\n",
        "            print(f\"Джарвис: {text}\")\n",
        "            try:\n",
        "                tts = gTTS(text=text, lang='ru', slow=False)\n",
        "                tts.save(\"temp_voice.mp3\")\n",
        "                if os.name == 'nt':\n",
        "                    os.startfile(\"temp_voice.mp3\")\n",
        "                else:\n",
        "                    # Заглушка для Colab/Linux\n",
        "                    print(\"(Аудиофайл сгенерирован)\")\n",
        "            except Exception as e:\n",
        "                print(f\"Ошибка звука: {e}\")\n",
        "            self.is_speaking = False\n",
        "        threading.Thread(target=_play).start()\n",
        "\n",
        "    def monitor_resources(self):\n",
        "        cpu = psutil.cpu_percent(interval=1)\n",
        "        ram = psutil.virtual_memory().percent\n",
        "        self.speak(f\"Текущая нагрузка системы: процессор {cpu} процентов, оперативная память {ram} процентов.\")\n",
        "\n",
        "    def create_report(self, title, content):\n",
        "        doc = Document()\n",
        "        doc.add_heading(title, 0)\n",
        "        doc.add_paragraph(content)\n",
        "        filename = f\"{title}.docx\"\n",
        "        doc.save(filename)\n",
        "        self.speak(f\"Сэр, отчет {title} готов.\")\n",
        "        return filename\n",
        "\n",
        "    def send_email_report(self, recipient, subject, body, attachment_path):\n",
        "        def _send():\n",
        "            msg = EmailMessage()\n",
        "            msg['Subject'] = subject\n",
        "            msg['From'] = self.email_address\n",
