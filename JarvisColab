      "source": [
        "import pygame\n",
        "import math\n",
        "import random\n",
        "\n",
        "# Код для локального запуска (скопируйте в файл black_hole.py)\n",
        "# pip install pygame\n",
        "\n",
        "def run_black_hole():\n",
        "    pygame.init()\n",
        "    width, height = 800, 800\n",
        "    screen = pygame.display.set_mode((width, height))\n",
        "    pygame.display.set_caption(\"Jarvis Visual Core: Black Hole\")\n",
        "    clock = pygame.time.Clock()\n",
        "\n",
        "    particles = []\n",
        "    for _ in range(300):\n",
        "        particles.append({\n",
        "            'angle': random.uniform(0, math.pi * 2),\n",
        "            'dist': random.randint(100, 300),\n",
        "            'speed': random.uniform(0.02, 0.05),\n",
        "            'size': random.randint(1, 3)\n",
        "        })\n",
        "\n",
        "    running = True\n",
        "    while running:\n",
        "        screen.fill((0, 0, 0))\n",
        "        center = (width // 2, height // 2)\n",
        "\n",
        "        for p in particles:\n",
        "            p['angle'] += p['speed']\n",
        "            x = center[0] + math.cos(p['angle']) * p['dist']\n",
        "            y = center[1] + math.sin(p['angle']) * p['dist']\n",
        "\n",
        "            # Эффект свечения\n",
        "            color = (random.randint(50, 100), random.randint(50, 150), 255)\n",
        "            pygame.draw.circle(screen, color, (int(x), int(y)), p['size'])\n",
        "\n",
        "        # Центральная сингулярность\n",
        "        pygame.draw.circle(screen, (0, 0, 0), center, 80)\n",
        "        pygame.draw.circle(screen, (20, 20, 20), center, 85, 2)\n",
        "\n",
        "        for event in pygame.event.get():\n",
        "            if event.type == pygame.QUIT:\n",
        "                running = False\n",
        "\n",
        "        pygame.display.flip()\n",
        "        clock.tick(60)\n",
        "\n",
        "    pygame.quit()\n",
        "\n",
        "# В Colab это не запустится (нужен монитор), но это готовый шаблон для вашего ПК.\n",
        "print(\"Скрипт готов для копирования в локальный .py файл.\")"
