        "\n",
        "    running = True\n",
        "    while running:\n",
        "        screen.fill((2, 2, 5)) # Глубокий космос\n",
        "        center = (width // 2, height // 2)\n",
        "\n",
        "        # Отрисовка диска (Интерстеллар стайл)\n",
        "        for p in particles:\n",
        "            p['angle'] += p['speed']\n",
        "            # Искажение для эффекта наклона диска\n",
        "            x = center[0] + math.cos(p['angle']) * p['dist']\n",
        "            y = center[1] + math.sin(p['angle']) * (p['dist'] * 0.3) # Приплюснутый эллипс\n",
